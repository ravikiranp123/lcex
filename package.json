{
  "name": "leet-plus",
  "displayName": "LeetPlus — Spaced Repetition Study Plans, Visual Algorithms & System Design",
  "description": "Prepare for technical interviews in VS Code. Featuring spaced repetition (SRS) study plans, visual step-through algorithms, Excalidraw system & low-level design diagrams, behavioral STAR mock interviews, and automated telemetry.",
  "version": "0.11.0",
  "publisher": "ravikiranp123",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Snippets",
    "Programming Languages",
    "Other"
  ],
  "icon": "icons/icon.png",
  "activationEvents": [
    "onUri",
    "onWebviewPanel:leetplusProblem",
    "workspaceContains:**/.leetplus/config.json",
    "workspaceContains:**/.leetcode",
    "onView:leetplus.onboardingView",
    "onCommand:leetplus.initializeWorkspace",
    "onCommand:leetplus.showDailyPlan"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravikiranp123/leet-plus"
  },
  "bugs": {
    "url": "https://github.com/ravikiranp123/leet-plus/issues"
  },
  "homepage": "https://github.com/ravikiranp123/leet-plus#readme",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "leetcode",
    "leet code",
    "leetcode practice",
    "leetcode problems",
    "leetcode solutions",
    "practice",
    "algorithm",
    "algorithms",
    "data structures",
    "dsa",
    "coding",
    "coding interview",
    "interview",
    "interview prep",
    "mock interview",
    "typescript",
    "javascript",
    "python",
    "cpp",
    "c++",
    "java",
    "study-plan",
    "top interview 150",
    "blind 75",
    "question of the day",
    "qotd"
  ],
