    "menus": {
      "editor/title": [
        {
          "command": "leetplus.openSolutionFromText",
          "when": "leetplus.hasMarker && resourceScheme == 'leetcode-problem-plain'",
          "group": "navigation"
        },
        {
          "command": "leetplus.agentMakeRunnable",
          "when": "leetplus.hasMarker && leetplus.isSolutionFile",
          "group": "navigation"
        },
        {
          "command": "leetplus.agentHint",
          "when": "leetplus.hasMarker && leetplus.isSolutionFile && !leetplus.interviewMode",
          "group": "navigation"
        },
        {
          "command": "leetplus.agentAnalyze",
          "when": "leetplus.hasMarker && leetplus.isSolutionFile && !leetplus.interviewMode",
          "group": "navigation"
        },
        {
          "command": "leetplus.openHintAnalysis",
          "when": "leetplus.hasMarker && leetplus.isSolutionFile && !leetplus.interviewMode",
          "group": "navigation"
        },
        {
          "command": "leetplus.agentExplainCode",
          "when": "leetplus.hasMarker && leetplus.isSolutionFile && !leetplus.interviewMode",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "leetplus.agentExplainCode",
          "when": "editorHasSelection && leetplus.hasMarker && leetplus.isSolutionFile && !leetplus.interviewMode",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "leetplus.markAsSolved",
          "when": "view == leetplus.problemsView || view == leetplus.topInterview150View || view == leetplus.problemListsView || view == leetplus.qotdView || (view == leetplus.contestsView && viewItem == leetplus.contestProblem) || (view == leetplus.companiesView && viewItem == leetplus.companyProblem)"
        },
        {
          "command": "leetplus.markAsAttempting",
          "when": "view == leetplus.problemsView || view == leetplus.topInterview150View || view == leetplus.problemListsView || view == leetplus.qotdView || (view == leetplus.contestsView && viewItem == leetplus.contestProblem) || (view == leetplus.companiesView && viewItem == leetplus.companyProblem)"
        },
        {
          "command": "leetplus.clearProblemStatus",
          "when": "view == leetplus.problemsView || view == leetplus.topInterview150View || view == leetplus.problemListsView || view == leetplus.qotdView || (view == leetplus.contestsView && viewItem == leetplus.contestProblem) || (view == leetplus.companiesView && viewItem == leetplus.companyProblem)"
        },
        {
          "command": "leetplus.openContestOnWeb",
          "when": "view == leetplus.contestsView && (viewItem == leetplus.upcomingContest || viewItem == leetplus.pastContest)",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "leetplus.filterByDifficulty",
          "when": "view == leetplus.problemsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.searchProblems",
          "when": "view == leetplus.problemsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.filterByDifficulty",
          "when": "view == leetplus.topInterview150View",
          "group": "navigation"
        },
        {
          "command": "leetplus.searchProblems",
          "when": "view == leetplus.topInterview150View",
          "group": "navigation"
        },
        {
          "command": "leetplus.refreshQotd",
          "when": "view == leetplus.qotdView",
          "group": "navigation"
        },
        {
          "command": "leetplus.switchStudyPlan",
          "when": "view == leetplus.topInterview150View",
          "group": "navigation"
        },
        {
          "command": "leetplus.filterByDifficulty",
          "when": "view == leetplus.problemListsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.searchProblems",
          "when": "view == leetplus.problemListsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.switchProblemList",
          "when": "view == leetplus.problemListsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.refreshContests",
          "when": "view == leetplus.contestsView",
          "group": "navigation"
        },
        {
          "command": "leetplus.searchCompanies",
          "when": "view == leetplus.companiesView",
          "group": "navigation@1"
        },
        {
          "command": "leetplus.filterCompaniesByDifficulty",
          "when": "view == leetplus.companiesView",
          "group": "navigation@2"
        },
        {
          "command": "leetplus.refreshCompanies",
          "when": "view == leetplus.companiesView",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetplus-container",
          "title": "LeetPlus",
          "icon": "./icons/icon-mono.svg"
        }
      ]
    },
    "views": {
      "leetplus-container": [
        {
          "id": "leetplus.onboardingView",
          "name": "Getting Started",
          "when": "!leetplus.hasMarker"
        }
      ],
      "explorer": [
        {
          "id": "leetplus.problemsView",
          "name": "Problems",
          "when": "leetplus.hasMarker && leetplus.showProblemset"
        },
        {
          "id": "leetplus.topInterview150View",
          "name": "Study Plans",
          "when": "leetplus.hasMarker && leetplus.showStudyPlans"
        },
        {
          "id": "leetplus.problemListsView",
          "name": "Problem Lists",
          "when": "leetplus.hasMarker && leetplus.showProblemLists"
        },
        {
          "id": "leetplus.qotdView",
          "name": "Question of the Day",
          "when": "leetplus.hasMarker && leetplus.showQotd"
        },
        {
          "id": "leetplus.contestsView",
          "name": "Practice Past Contests",
          "when": "leetplus.hasMarker && leetplus.showContests"
        },
        {
          "id": "leetplus.companiesView",
          "name": "Companies",
          "when": "leetplus.hasMarker && leetplus.showCompanies"
        },
        {
          "id": "leetplus.patternMasteryView",
          "name": "Pattern Mastery",
          "when": "leetplus.hasMarker"
        }
      ]
    },
    "keybindings": [
      {
        "command": "leetplus.runInTerminal",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "leetplus.hasMarker && leetplus.isSolutionFile && editorTextFocus"
      },
      {
        "command": "leetplus.clearInlineDecorations",
        "key": "ctrl+k ctrl+l",
        "mac": "cmd+k cmd+l",
        "when": "leetplus.hasMarker && editorTextFocus"
      }
    ],
    "viewsWelcome": [
      {
        "view": "leetplus.onboardingView",
        "contents": "Welcome to LeetPlus!\n\nTo start practicing and tracking your progress in this folder, you need to initialize it as a LeetPlus workspace. This will set up your local settings and workspace directories.\n\n[Initialize Workspace](command:leetplus.initializeWorkspace)"
      },
      {
        "view": "leetplus.problemsView",
        "contents": "Sign in to your LeetCode account and start practicing.\n\n[Sign in to LeetCode](command:leetplus.signIn)"
      },
      {
        "view": "leetplus.topInterview150View",
        "contents": "Interview study plans from LeetCode.\n\n[Switch study plan](command:leetplus.switchStudyPlan)"
      },
      {
        "view": "leetplus.problemListsView",
        "contents": "Curated LeetCode problem lists (e.g. /problem-list/graph/). Configure `problemLists` in .leetplus.\n\n[Switch problem list](command:leetplus.switchProblemList)"
      }
    ],
    "languages": [
      {
        "id": "leetplus-config",
        "aliases": [
          "LeetCode Config"
        ],
        "filenames": [
          ".leetplus"
        ],
        "icon": {
          "light": "./icons/logo-dark-16.png",
